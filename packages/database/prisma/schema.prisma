generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum StoreStatus {
  DRAFT
  CONNECTED
  DISABLED
}

enum SyncStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum SyncKind {
  PRODUCTS
  ORDERS
  INVENTORY
  WEBHOOK
}

enum WebhookStatus {
  RECEIVED
  PROCESSED
  FAILED
}

enum ExpenseStatus {
  DRAFT
  APPROVED
  VOID
}

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  APPROVED
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum StockMovementType {
  RECEIPT
  ADJUSTMENT
  TRANSFER
  RETURN_IN
  RETURN_OUT
}

enum StockMovementStatus {
  DRAFT
  POSTED
  REVERSED
}

enum StockCountStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  RECEIVED
  REFUNDED
  REJECTED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  TERMINATED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACTOR
  INTERN
}

enum AttendanceStatus {
  PRESENT
  REMOTE
  ABSENT
  LEAVE
}

enum LeaveRequestStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
}

enum WorkTaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
  CANCELLED
}

enum WorkTaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum KpiPeriod {
  MONTHLY
  QUARTERLY
  ANNUAL
}

enum PayrollRunStatus {
  DRAFT
  APPROVED
  EXPORTED
}

enum MarketingPlatform {
  META_ADS
  GOOGLE_ADS
  TIKTOK_ADS
}

enum IntegrationStatus {
  ACTIVE
  ERROR
  DISABLED
}

enum AlertType {
  LOW_STOCK
  LOW_MARGIN
  SYNC_FAILURE
  REVENUE_DROP
}

enum AlertEventStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum SupplierQuoteStatus {
  DRAFT
  RECEIVED
  ACCEPTED
  REJECTED
  EXPIRED
}

enum SupplierContractStatus {
  DRAFT
  ACTIVE
  EXPIRED
  TERMINATED
}

enum PurchaseRequestStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CONVERTED
  CANCELLED
}

enum ProcurementPaymentStatus {
  PLANNED
  PENDING_APPROVAL
  APPROVED
  PAID
  VOID
}

enum ProductLifecycleStatus {
  IDEA
  DEVELOPMENT
  READY
  ACTIVE
  DISCONTINUED
}

enum BusinessFunction {
  RND
  SALES
  MARKETING
  FINANCE
}

enum FulfillmentJobStatus {
  OPEN
  PICKING
  PACKED
  SHIPPED
  DELIVERED
  EXCEPTION
  CANCELLED
  RETURNED
}

enum ShipmentEventStatus {
  LABEL_CREATED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  EXCEPTION
  RETURNED
}

model Company {
  id                   String                      @id @default(uuid()) @db.Uuid
  name                 String
  code                 String                      @unique
  baseCurrency         String                      @default("USD") @map("base_currency")
  timezone             String                      @default("UTC")
  createdAt            DateTime                    @default(now()) @map("created_at")
  updatedAt            DateTime                    @updatedAt @map("updated_at")
  memberships          CompanyMembership[]
  roles                Role[]
  assignments          UserRoleAssignment[]
  stores               Store[]
  auditLogs            AuditLog[]
  internalSkus         InternalSku[]
  expenseCategories    ExpenseCategory[]
  expenses             Expense[]
  warehouses           Warehouse[]
  suppliers            Supplier[]
  purchaseOrders       PurchaseOrder[]
  stockMovements       StockMovement[]
  stockCounts          StockCount[]
  returns              ReturnRequest[]
  approvals            ApprovalRequest[]
  departments          Department[]
  employees            Employee[]
  workTasks            WorkTask[]
  kpiDefinitions       KpiDefinition[]
  payrollRuns          PayrollRun[]
  marketingConnections MarketingConnection[]
  forecastSnapshots    ForecastSnapshot[]
  alertRules           AlertRule[]
  supplierQuotes       SupplierQuote[]
  supplierContracts    SupplierContract[]
  supplierReviews      SupplierPerformanceReview[]
  purchaseRequests     PurchaseRequest[]
  procurementPayments  ProcurementPayment[]
  fulfillmentJobs      FulfillmentJob[]

  @@map("companies")
}

model User {
  id             String               @id @default(uuid()) @db.Uuid
  email          String               @unique
  name           String
  passwordHash   String               @map("password_hash")
  status         UserStatus           @default(ACTIVE)
  mfaSecret      String?              @map("mfa_secret")
  mfaEnabled     Boolean              @default(false) @map("mfa_enabled")
  sessionVersion Int                  @default(0) @map("session_version")
  lastLoginAt    DateTime?            @map("last_login_at")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")
  memberships    CompanyMembership[]
  assignments    UserRoleAssignment[]
  auditLogs      AuditLog[]           @relation("AuditActor")
  employees      Employee[]

  @@map("users")
}

model CompanyMembership {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@index([userId])
  @@map("company_memberships")
}

model Permission {
  code            String           @id
  description     String
  rolePermissions RolePermission[]

  @@map("permissions")
}

model Role {
  id          String               @id @default(uuid()) @db.Uuid
  companyId   String               @map("company_id") @db.Uuid
  name        String
  description String?
  isSystem    Boolean              @default(false) @map("is_system")
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")
  company     Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  assignments UserRoleAssignment[]

  @@unique([companyId, name])
  @@map("roles")
}

model RolePermission {
  roleId         String     @map("role_id") @db.Uuid
  permissionCode String     @map("permission_code")
  role           Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission     Permission @relation(fields: [permissionCode], references: [code], onDelete: Cascade)

  @@id([roleId, permissionCode])
  @@map("role_permissions")
}

model UserRoleAssignment {
  id          String     @id @default(uuid()) @db.Uuid
  userId      String     @map("user_id") @db.Uuid
  companyId   String     @map("company_id") @db.Uuid
  roleId      String     @map("role_id") @db.Uuid
  storeId     String?    @map("store_id") @db.Uuid
  warehouseId String?    @map("warehouse_id") @db.Uuid
  createdAt   DateTime   @default(now()) @map("created_at")
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  company     Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role        Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  store       Store?     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@index([userId, companyId])
  @@map("user_role_assignments")
}

model Store {
  id                   String                @id @default(uuid()) @db.Uuid
  companyId            String                @map("company_id") @db.Uuid
  name                 String
  shopifyDomain        String                @unique @map("shopify_domain")
  currency             String                @default("USD")
  status               StoreStatus           @default(DRAFT)
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  company              Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignments          UserRoleAssignment[]
  connection           ShopifyConnection?
  syncJobs             SyncJob[]
  webhooks             WebhookEvent[]
  products             Product[]
  orders               Order[]
  inventory            InventoryLevel[]
  customers            Customer[]
  orderEvents          OrderEvent[]
  expenses             Expense[]
  returns              ReturnRequest[]
  dailyMetrics         DailyMetric[]
  marketingConnections MarketingConnection[]
  alertRules           AlertRule[]

  @@index([companyId])
  @@map("stores")
}

model ShopifyConnection {
  storeId               String    @id @map("store_id") @db.Uuid
  encryptedAccessToken  String    @map("encrypted_access_token") @db.Text
  encryptedRefreshToken String?   @map("encrypted_refresh_token") @db.Text
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scopes                String[]
  installedAt           DateTime  @default(now()) @map("installed_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  store                 Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("shopify_connections")
}

model SyncJob {
  id          String     @id @default(uuid()) @db.Uuid
  storeId     String     @map("store_id") @db.Uuid
  kind        SyncKind
  status      SyncStatus @default(QUEUED)
  cursor      String?
  processed   Int        @default(0)
  error       String?    @db.Text
  startedAt   DateTime?  @map("started_at")
  completedAt DateTime?  @map("completed_at")
  createdAt   DateTime   @default(now()) @map("created_at")
  store       Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, createdAt])
  @@map("sync_jobs")
}

model WebhookEvent {
  id          String        @id @default(uuid()) @db.Uuid
  storeId     String        @map("store_id") @db.Uuid
  webhookId   String        @map("webhook_id")
  topic       String
  payload     Json
  status      WebhookStatus @default(RECEIVED)
  error       String?       @db.Text
  receivedAt  DateTime      @default(now()) @map("received_at")
  processedAt DateTime?     @map("processed_at")
  store       Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, webhookId])
  @@index([status, receivedAt])
  @@map("webhook_events")
}

model Product {
  id               String    @id @default(uuid()) @db.Uuid
  storeId          String    @map("store_id") @db.Uuid
  shopifyId        String    @map("shopify_id")
  title            String
  handle           String?
  status           String
  productType      String?   @map("product_type")
  vendor           String?
  imageUrl         String?   @map("image_url") @db.Text
  shopifyUpdatedAt DateTime  @map("shopify_updated_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  store            Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  variants         Variant[]

  @@unique([storeId, shopifyId])
  @@index([storeId, title])
  @@map("products")
}

model Variant {
  id              String           @id @default(uuid()) @db.Uuid
  productId       String           @map("product_id") @db.Uuid
  shopifyId       String           @unique @map("shopify_id")
  inventoryItemId String?          @map("inventory_item_id")
  title           String
  sku             String?
  barcode         String?
  price           Decimal          @db.Decimal(18, 4)
  currency        String
  position        Int
  product         Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory       InventoryLevel[]
  orderItems      OrderItem[]
  mapping         VariantMapping?

  @@index([sku])
  @@map("variants")
}

model Order {
  id                String           @id @default(uuid()) @db.Uuid
  storeId           String           @map("store_id") @db.Uuid
  shopifyId         String           @map("shopify_id")
  name              String
  email             String?
  financialStatus   String?          @map("financial_status")
  fulfillmentStatus String?          @map("fulfillment_status")
  currency          String
  subtotal          Decimal          @db.Decimal(18, 4)
  total             Decimal          @db.Decimal(18, 4)
  totalTax          Decimal          @map("total_tax") @db.Decimal(18, 4)
  totalShipping     Decimal          @map("total_shipping") @db.Decimal(18, 4)
  totalDiscount     Decimal          @map("total_discount") @db.Decimal(18, 4)
  cancelledAt       DateTime?        @map("cancelled_at")
  closedAt          DateTime?        @map("closed_at")
  shopifyCreatedAt  DateTime         @map("shopify_created_at")
  shopifyUpdatedAt  DateTime         @map("shopify_updated_at")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  store             Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customerId        String?          @map("customer_id") @db.Uuid
  tags              String[]         @default([])
  note              String?          @db.Text
  shippingAddress   Json?            @map("shipping_address")
  billingAddress    Json?            @map("billing_address")
  customer          Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items             OrderItem[]
  refunds           Refund[]
  fulfillments      Fulfillment[]
  events            OrderEvent[]
  expenses          Expense[]
  profitSnapshot    ProfitSnapshot?
  returns           ReturnRequest[]
  fulfillmentJobs   FulfillmentJob[]

  @@unique([storeId, shopifyId])
  @@index([storeId, shopifyCreatedAt])
  @@map("orders")
}

model OrderItem {
  id                  String                @id @default(uuid()) @db.Uuid
  orderId             String                @map("order_id") @db.Uuid
  shopifyId           String                @map("shopify_id")
  variantId           String?               @map("variant_id") @db.Uuid
  title               String
  sku                 String?
  quantity            Int
  unitPrice           Decimal               @map("unit_price") @db.Decimal(18, 4)
  discount            Decimal               @db.Decimal(18, 4)
  costUnitSnapshot    Decimal?              @map("cost_unit_snapshot") @db.Decimal(18, 4)
  costTotalSnapshot   Decimal?              @map("cost_total_snapshot") @db.Decimal(18, 4)
  order               Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant             Variant?              @relation(fields: [variantId], references: [id], onDelete: SetNull)
  refundItems         RefundLineItem[]
  fulfillmentItems    FulfillmentLineItem[]
  returnItems         ReturnItem[]
  fulfillmentJobItems FulfillmentJobItem[]

  @@unique([orderId, shopifyId])
  @@map("order_items")
}

model Customer {
  id          String   @id @default(uuid()) @db.Uuid
  storeId     String   @map("store_id") @db.Uuid
  shopifyId   String   @map("shopify_id")
  displayName String   @map("display_name")
  email       String?
  phone       String?
  ordersCount Int      @default(0) @map("orders_count")
  totalSpent  Decimal  @default(0) @map("total_spent") @db.Decimal(18, 4)
  currency    String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orders      Order[]

  @@unique([storeId, shopifyId])
  @@index([storeId, email])
  @@map("customers")
}

model Refund {
  id               String           @id @default(uuid()) @db.Uuid
  orderId          String           @map("order_id") @db.Uuid
  shopifyId        String           @map("shopify_id")
  amount           Decimal          @db.Decimal(18, 4)
  currency         String
  note             String?          @db.Text
  shopifyCreatedAt DateTime         @map("shopify_created_at")
  order            Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items            RefundLineItem[]

  @@unique([orderId, shopifyId])
  @@map("refunds")
}

model RefundLineItem {
  id           String     @id @default(uuid()) @db.Uuid
  refundId     String     @map("refund_id") @db.Uuid
  orderItemId  String?    @map("order_item_id") @db.Uuid
  quantity     Int
  subtotal     Decimal    @db.Decimal(18, 4)
  costReversal Decimal    @default(0) @map("cost_reversal") @db.Decimal(18, 4)
  refund       Refund     @relation(fields: [refundId], references: [id], onDelete: Cascade)
  orderItem    OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)

  @@map("refund_line_items")
}

model Fulfillment {
  id               String                @id @default(uuid()) @db.Uuid
  orderId          String                @map("order_id") @db.Uuid
  shopifyId        String                @map("shopify_id")
  status           String
  trackingCompany  String?               @map("tracking_company")
  trackingNumber   String?               @map("tracking_number")
  trackingUrl      String?               @map("tracking_url") @db.Text
  shopifyCreatedAt DateTime              @map("shopify_created_at")
  shopifyUpdatedAt DateTime              @map("shopify_updated_at")
  order            Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items            FulfillmentLineItem[]

  @@unique([orderId, shopifyId])
  @@map("fulfillments")
}

model FulfillmentLineItem {
  id            String      @id @default(uuid()) @db.Uuid
  fulfillmentId String      @map("fulfillment_id") @db.Uuid
  orderItemId   String?     @map("order_item_id") @db.Uuid
  quantity      Int
  fulfillment   Fulfillment @relation(fields: [fulfillmentId], references: [id], onDelete: Cascade)
  orderItem     OrderItem?  @relation(fields: [orderItemId], references: [id], onDelete: SetNull)

  @@map("fulfillment_line_items")
}

model OrderEvent {
  id          String   @id @default(uuid()) @db.Uuid
  storeId     String   @map("store_id") @db.Uuid
  orderId     String   @map("order_id") @db.Uuid
  type        String
  title       String
  description String?  @db.Text
  occurredAt  DateTime @map("occurred_at")
  createdAt   DateTime @default(now()) @map("created_at")
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, type, title, occurredAt])
  @@index([orderId, occurredAt])
  @@map("order_events")
}

model InternalSku {
  id                   String                  @id @default(uuid()) @db.Uuid
  companyId            String                  @map("company_id") @db.Uuid
  code                 String
  name                 String
  barcode              String?
  active               Boolean                 @default(true)
  createdAt            DateTime                @default(now()) @map("created_at")
  updatedAt            DateTime                @updatedAt @map("updated_at")
  company              Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  mappings             VariantMapping[]
  costs                CostPriceHistory[]
  purchaseOrderItems   PurchaseOrderItem[]
  movementLines        StockMovementLine[]
  warehouseBalances    WarehouseBalance[]
  stockCountItems      StockCountItem[]
  returnItems          ReturnItem[]
  forecasts            ForecastSnapshot[]
  supplierQuoteItems   SupplierQuoteItem[]
  purchaseRequestItems PurchaseRequestItem[]
  pimProfile           PimProfile?
  fulfillmentJobItems  FulfillmentJobItem[]
  departmentLinks      ProductDepartmentLink[]

  @@unique([companyId, code])
  @@index([companyId, name])
  @@map("internal_skus")
}

model CostPriceHistory {
  id            String      @id @default(uuid()) @db.Uuid
  internalSkuId String      @map("internal_sku_id") @db.Uuid
  amount        Decimal     @db.Decimal(18, 4)
  currency      String
  effectiveFrom DateTime    @map("effective_from")
  note          String?     @db.Text
  createdById   String?     @map("created_by_id") @db.Uuid
  createdAt     DateTime    @default(now()) @map("created_at")
  internalSku   InternalSku @relation(fields: [internalSkuId], references: [id], onDelete: Cascade)

  @@index([internalSkuId, effectiveFrom])
  @@map("cost_price_history")
}

model ExpenseCategory {
  id        String    @id @default(uuid()) @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  name      String
  code      String
  active    Boolean   @default(true)
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  expenses  Expense[]

  @@unique([companyId, code])
  @@map("expense_categories")
}

model Expense {
  id           String          @id @default(uuid()) @db.Uuid
  companyId    String          @map("company_id") @db.Uuid
  storeId      String?         @map("store_id") @db.Uuid
  orderId      String?         @map("order_id") @db.Uuid
  categoryId   String          @map("category_id") @db.Uuid
  amount       Decimal         @db.Decimal(18, 4)
  currency     String
  expenseDate  DateTime        @map("expense_date")
  description  String
  reference    String?
  status       ExpenseStatus   @default(DRAFT)
  createdById  String          @map("created_by_id") @db.Uuid
  approvedById String?         @map("approved_by_id") @db.Uuid
  approvedAt   DateTime?       @map("approved_at")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  company      Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  store        Store?          @relation(fields: [storeId], references: [id], onDelete: SetNull)
  order        Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  category     ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([companyId, expenseDate])
  @@index([storeId, expenseDate])
  @@map("expenses")
}

model ProfitSnapshot {
  id              String   @id @default(uuid()) @db.Uuid
  orderId         String   @unique @map("order_id") @db.Uuid
  currency        String
  grossRevenue    Decimal  @map("gross_revenue") @db.Decimal(18, 4)
  discounts       Decimal  @db.Decimal(18, 4)
  refunds         Decimal  @db.Decimal(18, 4)
  shippingIncome  Decimal  @map("shipping_income") @db.Decimal(18, 4)
  taxes           Decimal  @db.Decimal(18, 4)
  netRevenue      Decimal  @map("net_revenue") @db.Decimal(18, 4)
  cogs            Decimal  @db.Decimal(18, 4)
  transactionFees Decimal  @default(0) @map("transaction_fees") @db.Decimal(18, 4)
  expenses        Decimal  @default(0) @db.Decimal(18, 4)
  netProfit       Decimal  @map("net_profit") @db.Decimal(18, 4)
  marginPercent   Decimal  @map("margin_percent") @db.Decimal(9, 4)
  incompleteCost  Boolean  @default(false) @map("incomplete_cost")
  calculatedAt    DateTime @default(now()) @map("calculated_at")
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("profit_snapshots")
}

model Warehouse {
  id              String               @id @default(uuid()) @db.Uuid
  companyId       String               @map("company_id") @db.Uuid
  code            String
  name            String
  address         Json?
  active          Boolean              @default(true)
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")
  company         Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignments     UserRoleAssignment[]
  purchaseOrders  PurchaseOrder[]
  movementsFrom   StockMovement[]      @relation("MovementFromWarehouse")
  movementsTo     StockMovement[]      @relation("MovementToWarehouse")
  balances        WarehouseBalance[]
  stockCounts     StockCount[]
  fulfillmentJobs FulfillmentJob[]

  @@unique([companyId, code])
  @@map("warehouses")
}

model Supplier {
  id             String                      @id @default(uuid()) @db.Uuid
  companyId      String                      @map("company_id") @db.Uuid
  code           String
  name           String
  contactName    String?                     @map("contact_name")
  email          String?
  phone          String?
  address        Json?
  paymentTerms   String?                     @map("payment_terms")
  active         Boolean                     @default(true)
  createdAt      DateTime                    @default(now()) @map("created_at")
  updatedAt      DateTime                    @updatedAt @map("updated_at")
