  @@index([supplierId, status])
  @@map("supplier_quotes")
}

model SupplierQuoteItem {
  id            String        @id @default(uuid()) @db.Uuid
  quoteId       String        @map("quote_id") @db.Uuid
  internalSkuId String        @map("internal_sku_id") @db.Uuid
  quantity      Int
  minOrderQty   Int           @default(1) @map("min_order_qty")
  unitPrice     Decimal       @map("unit_price") @db.Decimal(18, 4)
  quote         SupplierQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  internalSku   InternalSku   @relation(fields: [internalSkuId], references: [id], onDelete: Restrict)

  @@unique([quoteId, internalSkuId])
  @@map("supplier_quote_items")
}

model SupplierContract {
  id          String                 @id @default(uuid()) @db.Uuid
  companyId   String                 @map("company_id") @db.Uuid
  supplierId  String                 @map("supplier_id") @db.Uuid
  number      String
  title       String
  status      SupplierContractStatus @default(DRAFT)
  startDate   DateTime               @map("start_date")
  endDate     DateTime?              @map("end_date")
  currency    String
  value       Decimal?               @db.Decimal(18, 4)
  terms       String?                @db.Text
  documentUrl String?                @map("document_url") @db.Text
  createdById String                 @map("created_by_id") @db.Uuid
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")
  company     Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier    Supplier               @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  @@unique([companyId, number])
  @@index([supplierId, status])
  @@map("supplier_contracts")
}

model SupplierPerformanceReview {
  id            String   @id @default(uuid()) @db.Uuid
  companyId     String   @map("company_id") @db.Uuid
  supplierId    String   @map("supplier_id") @db.Uuid
  periodStart   DateTime @map("period_start")
  periodEnd     DateTime @map("period_end")
  qualityScore  Int      @map("quality_score")
  deliveryScore Int      @map("delivery_score")
  priceScore    Int      @map("price_score")
  serviceScore  Int      @map("service_score")
  overallScore  Decimal  @map("overall_score") @db.Decimal(5, 2)
  notes         String?  @db.Text
  reviewedById  String   @map("reviewed_by_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier      Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  @@index([supplierId, periodEnd])
  @@map("supplier_performance_reviews")
}

model PurchaseRequest {
  id             String                @id @default(uuid()) @db.Uuid
  companyId      String                @map("company_id") @db.Uuid
  departmentId   String?               @map("department_id") @db.Uuid
  number         String
  title          String
  status         PurchaseRequestStatus @default(DRAFT)
  priority       WorkTaskPriority      @default(MEDIUM)
  neededBy       DateTime?             @map("needed_by")
  justification  String?               @db.Text
  requestedById  String                @map("requested_by_id") @db.Uuid
  approvedById   String?               @map("approved_by_id") @db.Uuid
  approvedAt     DateTime?             @map("approved_at")
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")
  company        Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department     Department?           @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  items          PurchaseRequestItem[]
  purchaseOrders PurchaseOrder[]

  @@unique([companyId, number])
  @@index([companyId, status, createdAt])
  @@map("purchase_requests")
}

model PurchaseRequestItem {
  id                String          @id @default(uuid()) @db.Uuid
  purchaseRequestId String          @map("purchase_request_id") @db.Uuid
  internalSkuId     String          @map("internal_sku_id") @db.Uuid
  quantity          Int
  targetUnitCost    Decimal?        @map("target_unit_cost") @db.Decimal(18, 4)
  notes             String?         @db.Text
  purchaseRequest   PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  internalSku       InternalSku     @relation(fields: [internalSkuId], references: [id], onDelete: Restrict)

  @@unique([purchaseRequestId, internalSkuId])
  @@map("purchase_request_items")
}

model ProcurementPayment {
  id                String                   @id @default(uuid()) @db.Uuid
  companyId         String                   @map("company_id") @db.Uuid
  purchaseOrderId   String                   @map("purchase_order_id") @db.Uuid
  reference         String
  status            ProcurementPaymentStatus @default(PLANNED)
  amount            Decimal                  @db.Decimal(18, 4)
  currency          String
  dueDate           DateTime?                @map("due_date")
  paidAt            DateTime?                @map("paid_at")
  paymentMethod     String?                  @map("payment_method")
  externalReference String?                  @map("external_reference")
  createdById       String                   @map("created_by_id") @db.Uuid
  approvedById      String?                  @map("approved_by_id") @db.Uuid
  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @updatedAt @map("updated_at")
  company           Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  purchaseOrder     PurchaseOrder            @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)

  @@unique([companyId, reference])
  @@index([purchaseOrderId, status])
  @@map("procurement_payments")
}

model PimProfile {
  internalSkuId   String                 @id @map("internal_sku_id") @db.Uuid
  lifecycleStatus ProductLifecycleStatus @default(IDEA) @map("lifecycle_status")
  brand           String?
  category        String?
  description     String?                @db.Text
  specifications  Json?
  hsCode          String?                @map("hs_code")
  countryOfOrigin String?                @map("country_of_origin")
  weightGrams     Int?                   @map("weight_grams")
  dimensions      Json?
  seo             Json?
  published       Boolean                @default(false)
  updatedById     String                 @map("updated_by_id") @db.Uuid
  updatedAt       DateTime               @updatedAt @map("updated_at")
  internalSku     InternalSku            @relation(fields: [internalSkuId], references: [id], onDelete: Cascade)
  media           ProductMedia[]

  @@map("pim_profiles")
}

model ProductMedia {
  id           String     @id @default(uuid()) @db.Uuid
  pimProfileId String     @map("pim_profile_id") @db.Uuid
  type         String
  url          String     @db.Text
  altText      String?    @map("alt_text")
  position     Int        @default(0)
  createdAt    DateTime   @default(now()) @map("created_at")
  pimProfile   PimProfile @relation(fields: [pimProfileId], references: [internalSkuId], onDelete: Cascade)

  @@index([pimProfileId, position])
  @@map("product_media")
}

model ProductDepartmentLink {
  id            String           @id @default(uuid()) @db.Uuid
  internalSkuId String           @map("internal_sku_id") @db.Uuid
  departmentId  String           @map("department_id") @db.Uuid
  function      BusinessFunction
  ownerNote     String?          @map("owner_note") @db.Text
  internalSku   InternalSku      @relation(fields: [internalSkuId], references: [id], onDelete: Cascade)
  department    Department       @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([internalSkuId, function])
  @@index([departmentId])
  @@map("product_department_links")
}

model FulfillmentJob {
  id           String               @id @default(uuid()) @db.Uuid
  companyId    String               @map("company_id") @db.Uuid
  orderId      String               @map("order_id") @db.Uuid
  warehouseId  String               @map("warehouse_id") @db.Uuid
  number       String
  status       FulfillmentJobStatus @default(OPEN)
  priority     WorkTaskPriority     @default(MEDIUM)
  assignedToId String?              @map("assigned_to_id") @db.Uuid
  promisedAt   DateTime?            @map("promised_at")
  packedAt     DateTime?            @map("packed_at")
  shippedAt    DateTime?            @map("shipped_at")
  deliveredAt  DateTime?            @map("delivered_at")
  note         String?              @db.Text
  createdById  String               @map("created_by_id") @db.Uuid
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")
  company      Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  order        Order                @relation(fields: [orderId], references: [id], onDelete: Restrict)
  warehouse    Warehouse            @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  items        FulfillmentJobItem[]
  shipment     FulfillmentShipment?

  @@unique([companyId, number])
  @@index([warehouseId, status, createdAt])
  @@index([orderId])
  @@map("fulfillment_jobs")
}

model FulfillmentJobItem {
  id               String         @id @default(uuid()) @db.Uuid
  fulfillmentJobId String         @map("fulfillment_job_id") @db.Uuid
  orderItemId      String         @map("order_item_id") @db.Uuid
  internalSkuId    String?        @map("internal_sku_id") @db.Uuid
  quantity         Int
  pickedQuantity   Int            @default(0) @map("picked_quantity")
  fulfillmentJob   FulfillmentJob @relation(fields: [fulfillmentJobId], references: [id], onDelete: Cascade)
  orderItem        OrderItem      @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  internalSku      InternalSku?   @relation(fields: [internalSkuId], references: [id], onDelete: SetNull)

  @@unique([fulfillmentJobId, orderItemId])
  @@map("fulfillment_job_items")
}

model FulfillmentShipment {
  id               String          @id @default(uuid()) @db.Uuid
  fulfillmentJobId String          @unique @map("fulfillment_job_id") @db.Uuid
  carrier          String
  service          String?
  trackingNumber   String          @map("tracking_number")
  trackingUrl      String?         @map("tracking_url") @db.Text
  labelUrl         String?         @map("label_url") @db.Text
  shippingCost     Decimal?        @map("shipping_cost") @db.Decimal(18, 4)
  currency         String?
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  fulfillmentJob   FulfillmentJob  @relation(fields: [fulfillmentJobId], references: [id], onDelete: Cascade)
  events           ShipmentEvent[]

  @@index([trackingNumber])
  @@map("fulfillment_shipments")
}

model ShipmentEvent {
  id          String              @id @default(uuid()) @db.Uuid
  shipmentId  String              @map("shipment_id") @db.Uuid
  status      ShipmentEventStatus
  location    String?
  description String?             @db.Text
  occurredAt  DateTime            @map("occurred_at")
  createdAt   DateTime            @default(now()) @map("created_at")
  shipment    FulfillmentShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, occurredAt])
  @@map("shipment_events")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  actorId      String?  @map("actor_id") @db.Uuid
  action       String
  resourceType String   @map("resource_type")
  resourceId   String   @map("resource_id")
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at")
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  actor        User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@map("audit_logs")
}
