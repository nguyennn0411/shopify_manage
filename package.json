{
  "name": "shopify-company-erp",
  "private": true,
  "version": "1.0.0",
  "workspaces": ["apps/frontend"],
  "scripts": {
    "dev": "docker compose up --build",
    "dev:frontend": "npm run dev -w @erp/frontend",
    "lint": "npm run lint -w @erp/frontend",
    "typecheck": "npm run typecheck -w @erp/frontend",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "npm run build -w @erp/frontend",
    "build:backend": "docker build -t company-erp-backend:local apps/backend",
    "test": "npm run test:frontend && npm run test:backend",
    "test:frontend": "npm run test -w @erp/frontend",
    "test:backend": "docker build --target test -t company-erp-backend-test:local apps/backend",
    "compose:config": "docker compose config --quiet"
  },
  "devDependencies": {
    "jsdom": "^27.4.0"
  }
}
