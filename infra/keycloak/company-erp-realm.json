{
  "realm": "company-erp",
  "enabled": true,
  "displayName": "Company ERP",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "sslRequired": "external",
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA256",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "clients": [
    {
      "clientId": "erp-backend",
      "name": "Company ERP BFF",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:8088/login/oauth2/code/keycloak",
        "${APP_ORIGIN}/login/oauth2/code/keycloak"
      ],
      "webOrigins": [
        "http://localhost:8088",
        "${APP_ORIGIN}"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8088/login##${APP_ORIGIN}/login"
      }
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "super-admin",
        "description": "Full ERP administration"
      },
      {
        "name": "company.read"
      },
      {
        "name": "company.write"
      },
      {
        "name": "stores.read"
      },
      {
        "name": "stores.write"
      },
      {
        "name": "sales.read"
      },
      {
        "name": "sales.write"
      },
      {
        "name": "inventory.read"
      },
      {
        "name": "inventory.write"
      },
      {
        "name": "supplier.read"
      },
      {
        "name": "supplier.write"
      },
      {
        "name": "procurement.read"
      },
      {
        "name": "procurement.write"
      },
      {
        "name": "pim.read"
      },
      {
        "name": "pim.write"
      },
      {
        "name": "fulfillment.read"
      },
      {
        "name": "fulfillment.write"
      },
      {
        "name": "finance.read"
      },
      {
        "name": "finance.write"
      },
      {
        "name": "analytics.read"
      },
      {
        "name": "audit.read"
      },
      {
        "name": "hr.access"
      },
      {
        "name": "hr.employee.read.basic"
      },
      {
        "name": "hr.employee.read.sensitive"
      },
      {
        "name": "hr.employee.write"
      },
      {
        "name": "hr.recruitment.read"
      },
      {
        "name": "hr.recruitment.write"
      },
      {
        "name": "hr.onboarding.read"
      },
      {
        "name": "hr.onboarding.write"
      },
      {
        "name": "hr.attendance.read"
      },
      {
        "name": "hr.attendance.write"
      },
      {
        "name": "hr.attendance.approve"
      },
      {
        "name": "hr.leave.read"
      },
      {
        "name": "hr.leave.write"
      },
      {
        "name": "hr.leave.approve"
      },
      {
        "name": "hr.payroll.read.own"
      },
      {
        "name": "hr.payroll.read.all"
