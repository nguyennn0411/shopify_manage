      {
        "name": "hr.offboarding.write"
      },
      {
        "name": "platform.metrics.read"
      },
      {
        "name": "pm.access"
      },
      {
        "name": "pm.project.read"
      },
      {
        "name": "pm.project.write"
      },
      {
