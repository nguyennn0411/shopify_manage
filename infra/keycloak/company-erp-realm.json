{
  "realm": "company-erp",
  "enabled": true,
  "displayName": "Company ERP",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "sslRequired": "external",
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA256",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "clients": [
    {
      "clientId": "erp-backend",
      "name": "Company ERP BFF",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:8088/login/oauth2/code/keycloak",
        "${APP_ORIGIN}/login/oauth2/code/keycloak"
      ],
      "webOrigins": [
        "http://localhost:8088",
        "${APP_ORIGIN}"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8088/login##${APP_ORIGIN}/login"
      },
      "protocolMappers": [
        {
          "name": "ERP realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String"
          }
        }
      ]
    }
  ],
  "roles": {
