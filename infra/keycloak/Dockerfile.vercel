FROM quay.io/keycloak/keycloak:26.8.1
ENV KC_DB=postgres \
    KC_HEALTH_ENABLED=true \
    KC_METRICS_ENABLED=true \
    KC_HTTP_RELATIVE_PATH=/auth
USER root
COPY company-erp-realm.json /opt/keycloak/data/import/company-erp-realm.json
COPY vercel-entrypoint.sh /opt/keycloak/bin/vercel-entrypoint.sh
RUN chmod +x /opt/keycloak/bin/vercel-entrypoint.sh
USER 1000
RUN /opt/keycloak/bin/kc.sh build
EXPOSE 80
ENTRYPOINT ["/opt/keycloak/bin/vercel-entrypoint.sh"]
